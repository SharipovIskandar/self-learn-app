<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SelfLearn.Mobile.ViewModels"
             x:Class="SelfLearn.Mobile.Views.VocabView"
             x:DataType="vm:VocabViewModel">

    <StackPanel Spacing="8" Margin="24" MaxWidth="400" VerticalAlignment="Center">
        <TextBlock Text="So'zlar" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Bu bo'lim ilovaga tez orada qo'shiladi. Hozircha uni self-learn.uz veb-saytida davom ettiring."
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
    </StackPanel>
</UserControl>
