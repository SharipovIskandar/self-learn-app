<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SelfLearn.Mobile.ViewModels"
             x:Class="SelfLearn.Mobile.Views.MainView"
             x:DataType="vm:ShellViewModel">

    <!-- Hozirgi ekran (Startup, Login, Home...). Mos View'ni ViewLocator ViewModel nomidan topadi. -->
    <ContentControl Content="{Binding Current}" />
</UserControl>
