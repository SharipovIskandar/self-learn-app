<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SelfLearn.Mobile.ViewModels"
             x:Class="SelfLearn.Mobile.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <StackPanel Spacing="16"
                Margin="24"
                MaxWidth="400"
                VerticalAlignment="Center">

        <TextBlock Text="{Binding Greeting}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <TextBlock Text="Mobil ilovaga muvaffaqiyatli kirdingiz."
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.7" />

        <!-- Daraja aniqlash testi ilovada hali yo'q: veb-saytga yo'naltiramiz -->
        <Border IsVisible="{Binding NeedsPlacementTest}"
                BorderBrush="Orange"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <TextBlock Text="Siz hali darajani aniqlash testidan o'tmagansiz. Hozircha uni self-learn.uz veb-saytida yakunlang."
                       TextWrapping="Wrap" />
        </Border>

        <Button Content="Chiqish"
                Command="{Binding LogoutCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                MinHeight="48" />

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />
    </StackPanel>
</UserControl>
